{
  "package": "Microwave",
  "events": {
    "evDoor": [],
    "evStart": [
      {
        "type": "int",
        "name": "seconds"
      }
    ],
    "evStop": [],
    "evTick": []
  },
  "classes": [
    {
      "name": "Oven",
      "attributes": [
        {
          "type": "int",
          "name": "remaining",
          "default": "0"
        },
        {
          "type": "int",
          "name": "doorOpen",
          "default": "0"
        },
        {
          "type": "int",
          "name": "beeps",
          "default": "0"
        }
      ],
      "operations": [
        {
          "name": "show",
          "ret": "void",
          "args": [
            {
              "type": "const char *",
              "name": "what"
            }
          ],
          "body": "printf(\"  oven: %s (remaining=%d, beeps=%d)\\n\", what, me->remaining, me->beeps);"
        }
      ],
      "statechart": {
        "initial": "idle",
        "states": {
          "idle": {
            "entry": "Oven_show(me, \"idle\");"
          },
          "doorOpen": {
            "entry": "me->doorOpen = 1;",
            "exit": "me->doorOpen = 0;"
          },
          "working": {
            "regions": [
              {
                "name": "heat",
                "initial": "heating",
                "history": true,
                "states": {
                  "heating": {
                    "entry": "Oven_show(me, \"heating\");"
                  },
                  "paused": {}
                }
              },
              {
                "name": "lamp",
                "initial": "lampOn",
                "states": {
                  "lampOn": {},
                  "lampBlink": {}
                }
              }
            ]
          },
          "done": {
            "initial": "beeping",
            "states": {
              "beeping": {
                "entry": "me->beeps++;"
              },
              "quiet": {}
            }
          }
        },
        "transitions": [
          {
            "from": "idle",
            "to": "working",
            "trigger": "evStart",
            "guard": "params->seconds > 0",
            "action": "me->remaining = params->seconds;"
          },
          {
            "from": "idle",
            "to": "doorOpen",
            "trigger": "evDoor"
          },
          {
            "from": "doorOpen",
            "to": "heat.H",
            "trigger": "evDoor",
            "guard": "me->remaining > 0"
          },
          {
            "from": "doorOpen",
            "to": "idle",
            "trigger": "evDoor"
          },
          {
            "from": "heating",
            "trigger": "evTick",
            "choice": [
              {
                "guard": "me->remaining > 1",
                "to": "heating",
                "action": "me->remaining--;"
              },
              {
                "guard": "else",
                "to": "done",
                "action": "me->remaining = 0;"
              }
            ]
          },
          {
            "from": "heating",
            "to": "paused",
            "trigger": "evStop"
          },
          {
            "from": "paused",
            "to": "heating",
            "trigger": "evStart"
          },
          {
            "from": "paused",
            "to": "idle",
            "trigger": "evStop",
            "action": "me->remaining = 0;"
          },
          {
            "from": "lampOn",
            "to": "lampBlink",
            "after": "500"
          },
          {
            "from": "lampBlink",
            "to": "lampOn",
            "after": "500"
          },
          {
            "from": "working",
            "to": "doorOpen",
            "trigger": "evDoor"
          },
          {
            "from": "beeping",
            "to": "beeping",
            "after": "1000",
            "guard": "me->beeps < 3"
          },
          {
            "from": "beeping",
            "to": "quiet",
            "after": "1000",
            "guard": "me->beeps >= 3"
          },
          {
            "from": "done",
            "to": "idle",
            "trigger": "evDoor"
          },
          {
            "from": "working",
            "trigger": "evTick",
            "guard": "IS_IN(paused)",
            "action": "Oven_show(me, \"tick while paused\");"
          }
        ]
      }
    }
  ],
  "types": [
    "#include <stdio.h>"
  ]
}
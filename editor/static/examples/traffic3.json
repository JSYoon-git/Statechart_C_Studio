      "kind": "state",
      "name": "RED",
      "x": 100,
      "y": 80,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\ncolor = 0u;\ncycle++;\nprintf(\"빨강 (%d번째 주기)\\n\", cycle);",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "green": {
      "kind": "state",
      "name": "GREEN",
      "x": 420,
      "y": 80,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\ncolor = 1u;\nprintf(\"초록\\n\");",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "yellow": {
      "kind": "state",
      "name": "YELLOW",
      "x": 260,
      "y": 240,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\ncolor = 2u;\nprintf(\"노랑\\n\");",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "i0": {
      "kind": "init",
      "x": 60,
      "y": 115,
      "parent": null,
      "region": 0
     }
    },
    "edges": {
     "e0": {
      "from": "i0",
      "to": "red",
      "trigger": "",
      "guard": "",
      "action": "",
      "bend": 0
     },
     "e1": {
      "from": "red",
      "to": "green",
      "trigger": "",
      "guard": "cnt >= redTicks",
      "action": "",
      "bend": 0
     },
     "e2": {
      "from": "green",
      "to": "yellow",
      "trigger": "",
      "guard": "cnt >= greenTicks",
      "action": "",
      "bend": 0
     },
     "e3": {
      "from": "yellow",
      "to": "red",
      "trigger": "",
      "guard": "cnt >= yellowTicks",
      "action": "",
      "bend": 0
     }
    },
    "notes": {
     "t1": {
      "id": "t1",
      "x": 450,
      "y": 225,
      "w": 230,
      "h": 90,
      "text": "One counter, cnt, is shared by all three states. Every entry/ sets it to 0, and the target is a config value.",
      "ko": "세 상태가 카운터 cnt 하나를 함께 씁니다. 상태에 들어올 때마다 entry/ 로 0으로 되돌리고, 목표값은 설정값입니다.",
      "attach": "yellow"
     }
    }
   }
  }
 ],
 "scenarios": [

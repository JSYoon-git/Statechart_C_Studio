     "name": "color",
     "default": "0",
     "dir": "out"
    },
    {
     "type": "uint16_t",
     "name": "redTicks",
     "default": "300u",
     "dir": "config"
    },
    {
     "type": "uint16_t",
     "name": "greenTicks",
     "default": "250u",
     "dir": "config"
    },
    {
     "type": "uint16_t",
     "name": "yellowTicks",
     "default": "100u",
     "dir": "config"
    },
    {
     "type": "int",
     "name": "cycle",
     "default": "0",
     "dir": "local"
    },
    {
     "type": "uint16_t",
     "name": "cnt",
     "default": "0",
     "dir": "local"
    }
   ],
   "operations": [],
   "assocs": [],
   "init": "",
   "chart": {

{
 "version": 4,
 "package": "Modem",
 "types": [
  "#include <stdio.h>"
 ],
 "events": [],
 "classes": [
  {
   "name": "Modem",
   "attributes": [
    {
     "type": "bool",
     "name": "connectOk",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "connectFail",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "uint16_t",
     "name": "data",
     "default": "0",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "hangup",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "online",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "bool",
     "name": "dialing",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "bool",
     "name": "gaveUp",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "int",
     "name": "maxRetries",
     "default": "3",
     "dir": "config"
    },
    {
     "type": "uint16_t",
     "name": "answerTimeoutTicks",
     "default": "200u",
     "dir": "config"
    },
    {
     "type": "uint16_t",
     "name": "retryDelayTicks",
     "default": "100u",
     "dir": "config"
    },
    {
     "type": "int",
     "name": "retries",
     "default": "0",
     "dir": "local"
    },
    {
     "type": "int",
     "name": "bytes",
     "default": "0",
     "dir": "local"
    },
    {
     "type": "uint16_t",
     "name": "cnt",
     "default": "0",
     "dir": "local"
    }
   ],
   "operations": [],
   "assocs": [],
   "init": "",
   "chart": {
    "nodes": {
     "dial": {
      "kind": "state",
      "name": "DIALING",
      "x": 80,
      "y": 100,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\nretries++;\ndialing = true;\nprintf(\"연결 시도 %d/%d\\n\", retries, maxRetries);",
      "exit": "dialing = false;",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "wait": {
      "kind": "state",
      "name": "WAIT_RETRY",
      "x": 60,
      "y": 380,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\nprintf(\"1초 후 다시 시도\\n\");",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "on": {
      "kind": "state",
      "name": "ONLINE",
      "x": 460,
      "y": 100,
      "w": 170,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "online = true;\nprintf(\"연결됨\\n\");\nretries = 0;",
      "exit": "online = false;",
      "reactions": [
       {
        "trigger": "",
        "guard": "data > 0u",
        "action": "bytes += data;\nprintf(\"수신 %u바이트 (누적 %d)\\n\", (unsigned)data, bytes);"
       }
      ]
     },
     "j": {
      "kind": "junction",
      "x": 380,
      "y": 300,
      "parent": null,
      "region": 0
     },
     "x": {
      "kind": "term",
      "x": 660,
      "y": 300,
      "parent": null,
      "region": 0
     },
     "i0": {
      "kind": "init",
      "x": 50,
      "y": 135,
      "parent": null,
      "region": 0
     }
    },
    "edges": {
     "e0": {
      "from": "i0",
      "to": "dial",
      "trigger": "",
      "guard": "",
      "action": "",
      "bend": 0
     },
     "e1": {
      "from": "dial",
      "to": "on",
      "trigger": "",
      "guard": "connectOk == true",
      "action": "",
      "bend": 0
     },
     "e2": {
      "from": "dial",
      "to": "j",
      "trigger": "",
      "guard": "connectFail == true",
      "action": "",
      "bend": -25
     },
     "e3": {
      "from": "dial",
      "to": "j",
      "trigger": "",
      "guard": "cnt >= answerTimeoutTicks",
      "action": "",
      "bend": 25
     },
     "e4": {
      "from": "j",
      "to": "wait",
      "trigger": "",
      "guard": "retries < maxRetries",
      "action": "",
      "bend": 0
     },
     "e5": {
      "from": "j",
      "to": "x",
      "trigger": "",
      "guard": "else",
      "action": "gaveUp = true;\nprintf(\"3번 실패 - 포기합니다\\n\");",
      "bend": 0
     },
     "e6": {
      "from": "wait",
      "to": "dial",
      "trigger": "",
      "guard": "cnt >= retryDelayTicks",
      "action": "",
      "bend": -30
     },
     "e7": {
      "from": "on",
      "to": "dial",
      "trigger": "",
      "guard": "hangup == true",
      "action": "printf(\"끊김 - 다시 연결\\n\");",
      "bend": 50
     }
    },
    "notes": {
     "t1": {
      "id": "t1",
      "x": 700,
      "y": 90,
      "w": 250,
      "h": 90,
      "text": "The reaction in ONLINE reads the data input directly: data > 0 adds to bytes. There is no event queue.",
      "ko": "ONLINE의 reaction이 입력 data를 바로 읽습니다. data > 0 이면 bytes에 더합니다. 이벤트 큐가 없습니다.",
      "attach": "on"
     },
     "t2": {
      "id": "t2",
      "x": 700,
      "y": 330,
      "w": 250,
      "h": 90,
      "text": "J merges the two failures. Below maxRetries try again, otherwise [else] ends the machine at the ⊗ connector.",
      "ko": "J가 두 가지 실패를 하나로 모읍니다. maxRetries 미만이면 다시 시도하고, 아니면 [else]로 ⊗ 커넥터에서 끝납니다.",
      "attach": null
     }
    }
   },
   "ioStyle": "struct"
  }
 ],
 "scenarios": [
  {
   "name": "Connects on the first try",
   "steps": [
    {
     "n": 1,
     "set": "",
     "expect": "online=false, dialing=true"
    },
    {
     "n": 1,
     "set": "connectOk=1",
     "expect": "online=true, dialing=false"
    }
   ]
  },
  {
   "name": "Incoming data does not disturb the connection",
   "steps": [
    {
     "n": 1,
     "set": "connectOk=1",
     "expect": "online=true"
    },
    {
     "n": 1,
     "set": "connectOk=0, data=100",
     "expect": "online=true"
    },
    {
     "n": 1,
     "set": "data=50",
     "expect": "online=true"
    },
    {
     "n": 1,
     "set": "data=0",
     "expect": "online=true"
    }
   ]
  },
  {
   "name": "Hangup dials again",
   "steps": [
    {
     "n": 1,
     "set": "connectOk=1",
     "expect": "online=true, dialing=false"
    },
    {
     "n": 1,
     "set": "connectOk=0, hangup=1",
     "expect": "online=false, dialing=true"
    }
   ]
  },
  {
   "name": "No answer: timeout after 200 calls",
   "steps": [
    {
     "n": 199,
     "set": "",
     "expect": "dialing=true"
    },
    {
     "n": 1,
     "set": "",
     "expect": "dialing=false, gaveUp=false"
    }
   ]
  },
  {
   "name": "Three failures and it gives up",
   "steps": [
    {
     "n": 1,
     "set": "",
     "expect": "dialing=true, gaveUp=false"
    },
    {
     "n": 1,
     "set": "connectFail=1",
     "expect": "dialing=false, gaveUp=false"
    },
    {
     "n": 100,
     "set": "connectFail=0",
     "expect": "dialing=true"
    },
    {
     "n": 1,
     "set": "connectFail=1",
     "expect": "dialing=false, gaveUp=false"
    },
    {
     "n": 100,
     "set": "connectFail=0",
     "expect": "dialing=true"
    },
    {
     "n": 1,
     "set": "connectFail=1",
     "expect": "dialing=false, gaveUp=true"
    }
   ]
  },
  {
   "name": "maxRetries=1: gives up after the first failure",
   "steps": [
    {
     "n": 1,
     "set": "maxRetries=1",
     "expect": "dialing=true",
     "init": true
    },
    {
     "n": 1,
     "set": "connectFail=1",
     "expect": "dialing=false, gaveUp=true"
    }
   ]
  }
 ]
}
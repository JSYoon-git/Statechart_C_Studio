{
 "version": 4,
 "package": "Debounce",
 "types": [
  "#include <stdio.h>"
 ],
 "events": [],
 "classes": [
  {
   "name": "Button",
   "attributes": [
    {
     "type": "bool",
     "name": "raw",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "pressed",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "uint8_t",
     "name": "debounceTicks",
     "default": "2u",
     "dir": "config"
    },
    {
     "type": "int",
     "name": "presses",
     "default": "0",
     "dir": "local"
    },
    {
     "type": "uint8_t",
     "name": "cnt",
     "default": "0",
     "dir": "local"
    }
   ],
   "operations": [],
   "assocs": [],
   "init": "",
   "chart": {
    "nodes": {
     "rel": {
      "kind": "state",
      "name": "RELEASED",
      "x": 60,
      "y": 80,
      "w": 160,
      "h": 60,
      "parent": null,
      "region": 0,
      "entry": "pressed = false;",
      "exit": "",
      "reactions": []
     },
     "dp": {
      "kind": "state",
      "name": "WAIT_PRESS",
      "x": 400,
      "y": 80,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "pr": {
      "kind": "state",
      "name": "PRESSED",
      "x": 400,
      "y": 260,
      "w": 160,
      "h": 60,
      "parent": null,
      "region": 0,
      "entry": "pressed = true;",
      "exit": "",
      "reactions": []
     },
     "dr": {
      "kind": "state",
      "name": "WAIT_RELEASE",
      "x": 60,
      "y": 260,
      "w": 160,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "i0": {
      "kind": "init",
      "x": 30,
      "y": 110,
      "parent": null,
      "region": 0
     }
    },
    "edges": {
     "e0": {
      "from": "i0",
      "to": "rel",
      "trigger": "",
      "guard": "",
      "action": "",
      "bend": 0
     },
     "e1": {
      "from": "rel",
      "to": "dp",
      "trigger": "",
      "guard": "raw == true",
      "action": "",
      "bend": 20
     },
     "e2": {
      "from": "dp",
      "to": "rel",
      "trigger": "",
      "guard": "raw == false",
      "action": "printf(\"튐 무시\\n\");",
      "bend": 20
     },
     "e3": {
      "from": "dp",
      "to": "pr",
      "trigger": "",
      "guard": "cnt >= debounceTicks",
      "action": "presses++;\nprintf(\"눌림 확정 (%d번째)\\n\", presses);",
      "bend": 0
     },
     "e4": {
      "from": "pr",
      "to": "dr",
      "trigger": "",
      "guard": "raw == false",
      "action": "",
      "bend": 20
     },
     "e5": {
      "from": "dr",
      "to": "pr",
      "trigger": "",
      "guard": "raw == true",
      "action": "",
      "bend": 20
     },
     "e6": {
      "from": "dr",
      "to": "rel",
      "trigger": "",
      "guard": "cnt >= debounceTicks",
      "action": "printf(\"떼짐 확정\\n\");",
      "bend": 0
     }
    },
    "notes": {
     "t1": {
      "id": "t1",
      "x": 620,
      "y": 70,
      "w": 250,
      "h": 90,
      "text": "Debounce: the raw level must stay the same for debounceTicks calls (2 x 10 ms = 20 ms) before it counts.",
      "ko": "디바운스: raw 값이 debounceTicks번(2 x 10 ms = 20 ms) 연속 같아야 인정합니다.",
      "attach": "dp"
     },
     "t2": {
      "id": "t2",
      "x": 620,
      "y": 250,
      "w": 250,
      "h": 80,
      "text": "pressed (the output) changes only after the check, so a bounce shorter than 20 ms is ignored.",
      "ko": "출력 pressed는 확인이 끝난 뒤에만 바뀝니다. 20 ms보다 짧은 튐은 무시됩니다.",
      "attach": "pr"
     }
    }
   }
  }
 ],
 "scenarios": [
  {
   "name": "A stable press is confirmed after 2 calls",
   "steps": [
    {
     "n": 0,
     "set": "",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=true"
    },
    {
     "n": 1,
     "set": "raw=0",
     "expect": "pressed=true"
    },
    {
     "n": 2,
     "set": "",
     "expect": "pressed=false"
    }
   ]
  },
  {
   "name": "A short bounce is ignored",
   "steps": [
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "raw=0",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=true"
    }
   ]
  },
  {
   "name": "A glitch while pressed is ignored",
   "steps": [
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=false"
    },
    {
     "n": 2,
     "set": "",
     "expect": "pressed=true"
    },
    {
     "n": 1,
     "set": "raw=0",
     "expect": "pressed=true"
    },
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=true"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=true"
    },
    {
     "n": 1,
     "set": "raw=0",
     "expect": "pressed=true"
    },
    {
     "n": 2,
     "set": "",
     "expect": "pressed=false"
    }
   ]
  },
  {
   "name": "Faster debounce: debounceTicks=1",
   "steps": [
    {
     "n": 0,
     "set": "debounceTicks=1",
     "expect": "pressed=false",
     "init": true
    },
    {
     "n": 1,
     "set": "raw=1",
     "expect": "pressed=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "pressed=true"
    }
   ]
  }
 ]
}
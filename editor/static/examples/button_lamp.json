{
 "version": 4,
 "package": "Lamp",
 "types": [
  "#include <stdio.h>"
 ],
 "events": [],
 "classes": [
  {
   "name": "Lamp",
   "attributes": [
    {
     "type": "bool",
     "name": "button",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "forceOff",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "lamp",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "int",
     "name": "pressCount",
     "default": "0",
     "dir": "local"
    }
   ],
   "operations": [],
   "assocs": [],
   "init": "",
   "chart": {
    "nodes": {
     "off": {
      "kind": "state",
      "name": "LAMP_OFF",
      "x": 110,
      "y": 90,
      "w": 170,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "lamp = false;\nprintf(\"램프 꺼짐\\n\");",
      "exit": "",
      "reactions": []
     },
     "on": {
      "kind": "state",
      "name": "LAMP_ON",
      "x": 420,
      "y": 90,
      "w": 170,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "lamp = true;\nprintf(\"램프 켜짐 (%d번 눌림)\\n\", pressCount);",
      "exit": "",
      "reactions": []
     },
     "i0": {
      "kind": "init",
      "x": 70,
      "y": 120,
      "parent": null,
      "region": 0
     }
    },
    "edges": {
     "e0": {
      "from": "i0",
      "to": "off",
      "trigger": "",
      "guard": "",
      "action": "",
      "bend": 0
     },
     "e1": {
      "from": "off",
      "to": "on",
      "trigger": "",
      "guard": "(button == true) && (forceOff == false)",
      "action": "pressCount++;",
      "bend": 22
     },
     "e2": {
      "from": "on",
      "to": "off",
      "trigger": "",
      "guard": "button == true",
      "action": "",
      "bend": 22
     },
     "e3": {
      "from": "on",
      "to": "off",
      "trigger": "",
      "guard": "forceOff == true",
      "action": "",
      "bend": -50
     }
    },
    "notes": {
     "t1": {
      "id": "t1",
      "x": 100,
      "y": 235,
      "w": 250,
      "h": 70,
      "text": "A transition's action (pressCount++) runs BEFORE the entry action of the next state.",
      "ko": "전이의 action(pressCount++)은 다음 상태의 entry action보다 먼저 실행됩니다.",
      "attach": "off"
     },
     "t2": {
      "id": "t2",
      "x": 400,
      "y": 235,
      "w": 230,
      "h": 80,
      "text": "Two ways out of LAMP_ON. When both guards are true, the first one in priority order wins.",
      "ko": "LAMP_ON에서 나가는 길이 둘입니다. 둘 다 참이면 우선순위가 앞선 것이 선택됩니다.",
      "attach": "on"
     }
    }
   }
  }
 ],
 "scenarios": [
  {
   "name": "Button switches the lamp",
   "steps": [
    {
     "n": 0,
     "set": "",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=true"
    },
    {
     "n": 1,
     "set": "button=0",
     "expect": "lamp=true"
    },
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "button=0",
     "expect": "lamp=false"
    }
   ]
  },
  {
   "name": "A held button toggles on every call",
   "steps": [
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=true"
    },
    {
     "n": 1,
     "set": "",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "",
     "expect": "lamp=true"
    },
    {
     "n": 1,
     "set": "button=0",
     "expect": "lamp=true"
    }
   ]
  },
  {
   "name": "forceOff keeps the lamp off",
   "steps": [
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=true"
    },
    {
     "n": 1,
     "set": "button=0, forceOff=1",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "button=0, forceOff=0",
     "expect": "lamp=false"
    },
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=true"
    }
   ]
  },
  {
   "name": "X_Init puts the lamp back to off",
   "steps": [
    {
     "n": 1,
     "set": "button=1",
     "expect": "lamp=true"
    },
    {
     "n": 0,
     "set": "",
     "expect": "lamp=false",
     "init": true
    }
   ]
  }
 ]
}
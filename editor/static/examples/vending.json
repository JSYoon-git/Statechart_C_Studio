{
 "version": 4,
 "package": "Vending",
 "types": [
  "#include <stdio.h>"
 ],
 "events": [],
 "classes": [
  {
   "name": "Machine",
   "attributes": [
    {
     "type": "int16_t",
     "name": "coin",
     "default": "0",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "select",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "cancel",
     "default": "false",
     "dir": "in"
    },
    {
     "type": "bool",
     "name": "dispense",
     "default": "false",
     "dir": "out"
    },
    {
     "type": "int",
     "name": "price",
     "default": "1000",
     "dir": "config"
    },
    {
     "type": "uint16_t",
     "name": "dispenseTicks",
     "default": "150u",
     "dir": "config"
    },
    {
     "type": "int",
     "name": "credit",
     "default": "0",
     "dir": "local"
    },
    {
     "type": "uint16_t",
     "name": "cnt",
     "default": "0",
     "dir": "local"
    }
   ],
   "operations": [],
   "assocs": [],
   "init": "",
   "chart": {
    "nodes": {
     "idle": {
      "kind": "state",
      "name": "IDLE",
      "x": 40,
      "y": 200,
      "w": 150,
      "h": 60,
      "parent": null,
      "region": 0,
      "entry": "dispense = false;\nprintf(\"동전을 넣으세요 (가격 %d원)\\n\", price);",
      "exit": "",
      "reactions": []
     },
     "col": {
      "kind": "state",
      "name": "COLLECTING",
      "x": 380,
      "y": 190,
      "w": 180,
      "h": 80,
      "parent": null,
      "region": 0,
      "entry": "printf(\"현재 금액 %d원\\n\", credit);",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "coin > 0",
        "action": "credit += coin;\nprintf(\"현재 금액 %d원\\n\", credit);"
       }
      ]
     },
     "disp": {
      "kind": "state",
      "name": "DISPENSING",
      "x": 720,
      "y": 200,
      "w": 170,
      "h": 70,
      "parent": null,
      "region": 0,
      "entry": "cnt = 0;\ndispense = true;\ncredit -= price;\nprintf(\"상품이 나옵니다. 거스름돈 %d원\\n\", credit);",
      "exit": "",
      "reactions": [
       {
        "trigger": "",
        "guard": "",
        "action": "cnt++;"
       }
      ]
     },
     "c1": {
      "kind": "cond",
      "x": 620,
      "y": 380,
      "parent": null,
      "region": 0
     },
     "i0": {
      "kind": "init",
      "x": 15,
      "y": 230,
      "parent": null,
      "region": 0
     }
    },
    "edges": {
     "e0": {
      "from": "i0",
      "to": "idle",
      "trigger": "",
      "guard": "",
      "action": "",
      "bend": 0
     },
     "e1": {
      "from": "idle",
      "to": "col",
      "trigger": "",
      "guard": "coin > 0",
      "action": "credit += coin;",
      "bend": 30
     },
     "e2": {
      "from": "col",
      "to": "idle",
      "trigger": "",
      "guard": "cancel == true",
      "action": "printf(\"%d원 반환\\n\", credit);\ncredit = 0;",
      "bend": 30
     },
     "e3": {
      "from": "col",
      "to": "c1",
      "trigger": "",
      "guard": "select == true",
      "action": "",
      "bend": -25
     },
     "e4": {
      "from": "c1",
      "to": "disp",
      "trigger": "",
      "guard": "credit >= price",
      "action": "",
      "bend": -25
     },
     "e5": {
      "from": "c1",
      "to": "col",
      "trigger": "",
      "guard": "else",
      "action": "printf(\"금액이 부족합니다\\n\");",
      "bend": -40
     },
     "e6": {
      "from": "disp",
      "to": "idle",
      "trigger": "",
      "guard": "cnt >= dispenseTicks",
      "action": "credit = 0;",
      "bend": 170
     }
    },
    "notes": {
     "t1": {
      "id": "t1",
      "x": 380,
      "y": 60,
      "w": 240,
      "h": 80,
      "text": "No events: coin is an input that carries a value. The reaction adds it on every call while coin > 0.",
      "ko": "이벤트가 없습니다. coin은 값을 가진 입력입니다. coin > 0 인 동안 매 호출마다 reaction이 더합니다.",
      "attach": "col"
     },
     "t2": {
      "id": "t2",
      "x": 670,
      "y": 400,
      "w": 250,
      "h": 80,
      "text": "C is a condition connector: [credit >= price] goes on, [else] goes back to COLLECTING.",
      "ko": "C는 조건 커넥터입니다. [credit >= price]면 진행하고, [else]면 COLLECTING으로 돌아갑니다.",
      "attach": null
     }
    }
   }
  }
 ],
 "scenarios": [
  {
   "name": "Buy: two coins, select, dispense",
   "steps": [
    {
     "n": 0,
     "set": "",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=500",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=500",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, select=1",
     "expect": "dispense=true"
    },
    {
     "n": 149,
     "set": "select=0",
     "expect": "dispense=true"
    },
    {
     "n": 1,
     "set": "",
     "expect": "dispense=false"
    }
   ]
  },
  {
   "name": "Not enough credit: nothing, and the credit is kept",
   "steps": [
    {
     "n": 1,
     "set": "coin=500",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, select=1",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "select=0, coin=500",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, select=1",
     "expect": "dispense=true"
    }
   ]
  },
  {
   "name": "Cancel gives the money back",
   "steps": [
    {
     "n": 1,
     "set": "coin=300",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, cancel=1",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "cancel=0, coin=700",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, select=1",
     "expect": "dispense=false"
    }
   ]
  },
  {
   "name": "Cheaper price: price=300",
   "steps": [
    {
     "n": 0,
     "set": "price=300",
     "expect": "dispense=false",
     "init": true
    },
    {
     "n": 1,
     "set": "coin=300",
     "expect": "dispense=false"
    },
    {
     "n": 1,
     "set": "coin=0, select=1",
     "expect": "dispense=true"
    }
   ]
  }
 ]
}